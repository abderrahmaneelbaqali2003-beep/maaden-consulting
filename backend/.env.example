# Copiez ce fichier en ".env" (dans le meme dossier backend/) et remplissez les vraies valeurs.
# Ne jamais committer le fichier .env reel dans Git.

# --- Base de donnees PostgreSQL ---
# Remplacez "votre_mot_de_passe" par le mot de passe reel de l'utilisateur lighting_app
DATABASE_URL=postgresql+psycopg://lighting_app:votre_mot_de_passe@localhost:5432/lighting_decision_db

# --- CORS : origine autorisee du frontend local ---
CORS_ORIGINS=http://localhost:5173

# --- Moteur de recommandation : parametres configurables ---
# Marge de securite de puissance driver/module (1.10 = 10% de marge minimum)
SAFETY_FACTOR=1.10
# Tolerance de correspondance du flux lumineux (module accepte entre 95% et 115% du flux demande)
FLUX_TOLERANCE_MIN=0.95
FLUX_TOLERANCE_MAX=1.15
# Tolerance courant driver a courant fixe (mA)
CURRENT_FIXED_TOLERANCE_MA=0
# Tolerance de correspondance tension/courant nominal du module par rapport au besoin saisi (%)
MODULE_VOLTAGE_TOLERANCE_PERCENT=10
MODULE_CURRENT_TOLERANCE_PERCENT=10
# Tolerance entraxe module/lentille (mm)
LENS_PITCH_TOLERANCE_MM=0.2
# Nombre de configurations renvoyees par le moteur de recommandation
MAX_RESULTS=3

# --- Import de fichiers ---
MAX_IMPORT_FILE_SIZE_MB=20

# --- Logging ---
LOG_LEVEL=INFO

# --- Environnement ---
ENVIRONMENT=development
