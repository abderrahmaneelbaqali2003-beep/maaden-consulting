# Copiez ce fichier en ".env" (dans le meme dossier backend/) et remplissez les vraies valeurs.
# Ne jamais committer le fichier .env reel dans Git.

# --- Base de donnees PostgreSQL ---
# Remplacez "votre_mot_de_passe" par le mot de passe reel de l'utilisateur lighting_app
DATABASE_URL=postgresql+psycopg://lighting_app:votre_mot_de_passe@localhost:5432/lighting_decision_db

# --- CORS : origines autorisees du frontend local ---
# "localhost" et "127.0.0.1" sont deux origines distinctes pour le navigateur (meme si les deux
# pointent vers la meme machine) : les deux doivent etre listees pour que le frontend fonctionne
# quelle que soit l'adresse utilisee pour l'ouvrir.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Moteur de recommandation : parametres configurables ---
# Marge de securite de puissance driver/module (1.10 = 10% de marge minimum)
SAFETY_FACTOR=1.10
# Tolerance de correspondance du flux lumineux (module accepte entre 95% et 115% du flux demande)
FLUX_TOLERANCE_MIN=0.95
FLUX_TOLERANCE_MAX=1.15
# Tolerance courant driver a courant fixe (mA)
CURRENT_FIXED_TOLERANCE_MA=0
# Tolerance de correspondance tension/courant nominal du module par rapport au besoin saisi (%)
MODULE_VOLTAGE_TOLERANCE_PERCENT=10
MODULE_CURRENT_TOLERANCE_PERCENT=10
# Tolerance entraxe module/lentille (mm)
LENS_PITCH_TOLERANCE_MM=0.2
# Nombre de configurations renvoyees par le moteur de recommandation
MAX_RESULTS=3

# --- Import de fichiers ---
MAX_IMPORT_FILE_SIZE_MB=20

# --- Logging ---
LOG_LEVEL=INFO

# --- Environnement ---
ENVIRONMENT=development

# --- V2 : base documentaire normative (RAG) ---
# Embeddings stockes en JSONB (aucune extension PostgreSQL native requise).
RAG_ENABLED=true
# "mock" (aucune dependance, deterministe) ou "sentence_transformer" (necessite le paquet
# sentence-transformers + le modele local, cf. requirements.txt).
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
# Nombre de passages documentaires retournes par recherche
RAG_TOP_K=5
# Seuil minimal de similarite cosinus applique au cote vectoriel de la recherche hybride
RAG_MIN_SCORE=0.65
# Decoupage des documents (caracteres)
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
# Reserve pour un futur upload utilisateur (non utilise en V2)
MAX_UPLOAD_SIZE_MB=25
ALLOWED_DOCUMENT_TYPES=pdf,docx,txt,md,csv,xlsx
